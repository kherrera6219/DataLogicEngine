# Universal Knowledge Graph (UKG) System Environment Variables
# Copy this file to .env and fill in the appropriate values
#
# ⚠️  SECURITY WARNING: Never commit .env file to version control!
# The .env file contains sensitive credentials and should be stored securely.
#
# 🔧 QUICK SETUP:
#    1. Run: python scripts/generate_secrets.py > .env.production
#    2. Edit .env.production with your specific values
#    3. Run: python scripts/validate_production_config.py
#    4. Copy validated .env.production to .env before deployment

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
FLASK_ENV=production                        # development, testing, or production
FLASK_DEBUG=False                           # MUST be False in production!
PORT=5000                                   # Backend API port (default: 5000)
AUTO_CREATE_SCHEMA=False                    # Local-only escape hatch; prefer `flask db upgrade`

# ============================================================================
# SECURITY SETTINGS - CRITICAL FOR PRODUCTION ⚠️
# ============================================================================
# 🔐 AUTO-GENERATE ALL SECRETS:
#    Run: python scripts/generate_secrets.py
#
# OR manually generate using:
#    python3 -c "import secrets; print(secrets.token_hex(32))"
#
# 🚨 PRODUCTION REQUIREMENTS:
#    - All keys must be 64+ characters
#    - Never reuse secrets across environments
#    - Rotate secrets every 90 days
#    - Store securely (AWS Secrets Manager, Azure Key Vault, etc.)
#
SECRET_KEY=                                 # REQUIRED: 64-char hex for Flask sessions
JWT_SECRET_KEY=                             # REQUIRED: 64-char hex for JWT tokens
SESSION_SECRET=                             # REQUIRED: 64-char hex for session signing
WTF_CSRF_SECRET_KEY=                        # OPTIONAL: 64-char hex for CSRF protection

# Request size limits (Phase 1 security hardening)
MAX_CONTENT_LENGTH=16777216                 # Maximum request size in bytes (16MB default)

# ============================================================================
# DATABASE SETTINGS
# ============================================================================
# PostgreSQL connection (recommended for production)
DATABASE_URL=postgresql://user:password@localhost:5432/ukg_database
PGUSER=user
PGPASSWORD=password
PGHOST=localhost
PGPORT=5432
PGDATABASE=ukg_database

# Connection Pool Tuning (adjust based on load testing results)
# For most production workloads: pool_size = (2 * CPU cores) + disk spindles
# Recommended values:
#   - Small (1-2 cores): pool_size=5, max_overflow=10
#   - Medium (4-8 cores): pool_size=20, max_overflow=30
#   - Large (16+ cores): pool_size=50, max_overflow=100
DB_POOL_SIZE=20                             # Base connection pool size
DB_POOL_MAX_OVERFLOW=30                     # Extra connections allowed during peak load
DB_POOL_RECYCLE=300                         # Recycle connections every 5 minutes
DB_POOL_TIMEOUT=30                          # Timeout waiting for connection from pool

# Windows 11 full local profile (Docker data services)
# Use this profile when starting with:
#   powershell -ExecutionPolicy Bypass -File .\scripts\windows\start_local_stack.ps1 -WithDataServices
# If services are already running on these ports, the startup script will auto-detect
# their credentials when possible and inject a matching runtime profile.
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/ukg_db
# REDIS_URL=redis://127.0.0.1:6379/10
# RATELIMIT_STORAGE_URI=redis://127.0.0.1:6379/11
# CELERY_BROKER_URL=redis://127.0.0.1:6379/12
# CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/13
# USE_REDIS=true
# NEO4J_URI=bolt://127.0.0.1:7687
# NEO4J_HTTP_PORT=7474
# NEO4J_LOCAL_PORT=7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=neo4jpassword
# OBJECT_ENDPOINT_URL=http://127.0.0.1:9000
# OBJECT_ACCESS_KEY=minioadmin
# OBJECT_SECRET_KEY=minioadmin123
# OBJECT_BUCKET=datalogic
# VECTOR_LOCAL_PATH=./databases/chroma
# OBJECT_LOCAL_PATH=./databases/objects
# Development/repair-only ingestion path overrides. Production uses protected
# app-owned runtime-root paths and must not point these at arbitrary user roots.
# DATALOGIC_INGESTION_STAGING_ROOT=./runtime/ingestion/staging
# DATALOGIC_INGESTION_ARTIFACT_SPOOL_ROOT=./runtime/ingestion/artifact-spool

# ============================================================================
# AI MODEL (CLOUD)
# ============================================================================
# DataLogicEngine uses one user-selected cloud model: OpenAI gpt-5.5 or Google
# gemini-3.1-pro-preview. Keys are normally saved encrypted in the app DB via
# Settings -> AI/Model, but may also be set here for headless / dev runs:
# OPENAI_API_KEY=                             # enables the OpenAI gpt-5.5 model
# GOOGLE_API_KEY=                             # enables Google gemini-3.1-pro-preview (or use GEMINI_API_KEY)
# GEMINI_API_KEY=                             # alternate Google/Gemini key name
# LLM_DEFAULT_PROVIDER=                       # optional: google or openai; env fallback preference when multiple keys are set
# GOOGLE_MODEL_PRIMARY=gemini-3.1-pro-preview # optional Google primary model override
# GOOGLE_MODEL_FAST=gemini-3.1-pro-preview    # optional Google fast/test model override
# GEMINI_TEST_MODEL=gemini-3.1-pro-preview    # optional live key validation model

# ============================================================================
# LOGGING SETTINGS
# ============================================================================
LOG_LEVEL=INFO                              # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE=ukg_system.log                     # Path to log file
LOG_AGGREGATION_HOST=                       # Optional: syslog/ELK host
LOG_AGGREGATION_PORT=514                    # Optional: syslog port
LOG_AGGREGATION_PROTOCOL=udp                # Optional: udp or tcp
BACKUP_CRON_SCHEDULE=0 2 * * *              # Optional: cron schedule for backups

# ============================================================================
# UKG SYSTEM SETTINGS
# ============================================================================
UKG_MAX_SIMULATION_LAYERS=7                 # Maximum number of simulation layers to use (1-10)
UKG_DEFAULT_CONFIDENCE_THRESHOLD=0.85       # Default confidence threshold for simulations
UKG_DEFAULT_REFINEMENT_STEPS=12             # Default number of refinement steps
UKG_MEMORY_CACHE_SIZE=4096                  # Memory cache size in MB
UKG_ENABLE_QUANTUM_SIMULATION=false         # Enable Layer 8 (Quantum Simulation)
UKG_ENABLE_RECURSIVE_PROCESSING=true        # Enable Layer 9 (Recursive Processing)

# ============================================================================
# AZURE OPENAI (optional cloud LLM provider)
# ============================================================================
# Optional: route the gateway's "azure" provider through Azure-hosted OpenAI.
# Current Settings UI provider keys (OpenAI / Google) are stored ENCRYPTED in
# the app database. Azure OpenAI can be supplied through the env values below.
# NOTE: single-mode / OS-level auth means there is no Azure AD / Entra ID /
# Microsoft Graph SSO — those env vars were removed with the multi-user auth
# surface (auth deprecation Phases A–F).
AZURE_OPENAI_ENDPOINT=                      # https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_KEY=                       # Azure OpenAI API key (maps to the "azure" gateway provider)
AZURE_OPENAI_API_VERSION=2024-10-21         # Azure OpenAI API version

# ============================================================================
# CORS (Cross-Origin Resource Sharing)
# ============================================================================
# SECURITY WARNING: NEVER use * (wildcard) in production!
# Specify exact domains, e.g.: https://app.yourdomain.com,https://admin.yourdomain.com
CORS_ORIGINS=https://app.yourdomain.com,https://admin.yourdomain.com # Comma-separated list of allowed origins

# ============================================================================
# FRONTEND SETTINGS (Next.js)
# ============================================================================
# The frontend is Next.js + Electron (NEXT_PUBLIC_* prefix, not REACT_APP_*).
# Auth is OS-level/single-mode, so there is no web auth-provider setting.
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1  # URL the frontend uses to reach the backend
NEXT_PUBLIC_CDN_URL=                        # Optional CDN base URL for Next.js static assets

# ============================================================================
# SESSION & COOKIE SECURITY
# ============================================================================
SESSION_COOKIE_SECURE=true                  # Set to true in production (requires HTTPS)
SESSION_COOKIE_HTTPONLY=true                # Prevents JavaScript access to cookies
SESSION_COOKIE_SAMESITE=Strict              # SameSite policy: Lax or Strict
SESSION_LIFETIME_MINUTES=30                 # Session lifetime in minutes
REMEMBER_COOKIE_SECURE=true                 # Set to true in production (requires HTTPS)
REMEMBER_COOKIE_DURATION=2592000            # 30 days in seconds

# ============================================================================
# RATE LIMITING
# ============================================================================
GLOBAL_RATE_LIMIT=200 per hour              # Global rate limit for all endpoints
RATELIMIT_STORAGE_URI=redis://localhost:6379 # Use redis://localhost:6379 for production

# ============================================================================
# ADMIN USER (Initial Setup Only) 🔐
# ============================================================================
# 🚨 SECURITY CRITICAL: Change these immediately after first deployment!
#
# ⚠️  NEVER USE THESE VALUES:
#    ✗ admin / admin123
#    ✗ administrator / password
#    ✗ root / 123456
#
# ✅ SECURE CREDENTIALS:
#    Generated by scripts/generate_secrets.py
#    OR manually: password must be 24+ chars with uppercase, lowercase, digits, symbols
#
ADMIN_USERNAME=                             # REQUIRED: Unique username (not 'admin')
ADMIN_PASSWORD=                             # REQUIRED: Strong password (24+ chars)
ADMIN_EMAIL=                                # REQUIRED: Admin email address
