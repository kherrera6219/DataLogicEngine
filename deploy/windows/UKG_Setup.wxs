<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi" xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">
    <Product Id="*" Name="DataLogicEngine" Language="1033" Version="1.2.4.0" Manufacturer="DataLogic" UpgradeCode="a8342468-b391-4d1a-96e0-1c8632607831">
        <Package InstallerVersion="200" Compressed="yes" InstallScope="perMachine" Platform="x64" />

        <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
        <MediaTemplate EmbedCab="yes" />

        <Feature Id="ProductFeature" Title="DataLogicEngine" Level="1">
            <ComponentGroupRef Id="ProductComponents" />
            <ComponentGroupRef Id="StartMenuComponents" />
            <ComponentGroupRef Id="ScriptComponents" />
            <ComponentGroupRef Id="ServiceComponents" />
        </Feature>

        <UI>
            <UIRef Id="WixUI_InstallDir" />
            <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="2">1</Publish>
            <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2">1</Publish>
        </UI>
        <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />

        <!-- Custom Actions for PowerShell Orchestration -->
        <Binary Id="InstallScript" SourceFile="scripts/windows/install.ps1" />
        <Binary Id="UninstallScript" SourceFile="scripts/windows/uninstall.ps1" />

        <CustomAction Id="RunInstallScript" 
                      BinaryKey="WixCA" 
                      DllEntry="WixQuietExec" 
                      Execute="deferred" 
                      Return="check" 
                      Impersonate="no" />
        
        <Property Id="RunInstallScript" Value="&quot;powershell.exe&quot; -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]scripts\install.ps1&quot; -InstallPath &quot;[INSTALLFOLDER]&quot; -DataPath &quot;[DATAFOLDER]&quot;" />

        <InstallExecuteSequence>
            <Custom Action="RunInstallScript" After="InstallFiles">NOT Installed</Custom>
        </InstallExecuteSequence>

    </Product>

    <Fragment>
        <Directory Id="TARGETDIR" Name="SourceDir">
            <Directory Id="ProgramFiles64Folder">
                <Directory Id="INSTALLFOLDER" Name="DataLogicEngine">
                    <Directory Id="SCRIPTFOLDER" Name="scripts" />
                </Directory>
            </Directory>
            <Directory Id="CommonAppDataFolder">
                <Directory Id="DATAFOLDER" Name="DataLogicEngine" />
            </Directory>
            <Directory Id="CommonProgramsFolder">
                <Directory Id="ApplicationProgramsFolder" Name="DataLogicEngine"/>
            </Directory>
        </Directory>
    </Fragment>

    <Fragment>
        <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
            <!-- Backend Binary (Bundled by PyInstaller) -->
            <Component Id="BackendExe" Guid="*" Win64="yes">
                <File Id="BackendExeFile" Source="dist/DataLogic_Backend/DataLogic_Backend.exe" Name="DataLogic_Backend_App.exe" KeyPath="yes" />
            </Component>
            
            <!-- Frontend Standalone (Next.js) -->
            <Component Id="FrontendServer" Guid="*" Win64="yes">
                <File Id="FrontendServerFile" Source="frontend/.next/standalone/server.js" KeyPath="yes" />
            </Component>

            <!-- URL launcher file -->
            <Component Id="ApplicationShortcutFile" Guid="*" Win64="yes">
                <File Id="WebShortcut" Name="DataLogicEngine.url" Source="deploy/windows/DataLogicEngine.url" KeyPath="yes" />
            </Component>

        </ComponentGroup>

        <ComponentGroup Id="StartMenuComponents" Directory="ApplicationProgramsFolder">
            <!-- Start menu shortcut -->
            <Component Id="ApplicationStartMenuShortcut" Guid="*">
                <CreateFolder />
                <Shortcut Id="ApplicationStartMenuShortcut"
                          Name="DataLogicEngine"
                          Description="Launch DataLogicEngine Desktop"
                          Target="[INSTALLFOLDER]DataLogicEngine.url" />
                <RemoveFolder Id="CleanupShortcut" On="uninstall" />
                <RegistryValue Root="HKLM" Key="Software\DataLogic\DataLogicEngine" Name="installed" Type="integer" Value="1" KeyPath="yes" />
            </Component>
        </ComponentGroup>

        <ComponentGroup Id="ScriptComponents" Directory="SCRIPTFOLDER">
            <Component Id="InstallPs1" Guid="*" Win64="yes">
                <File Id="InstallPs1File" Source="scripts/windows/install.ps1" KeyPath="yes" />
            </Component>
            <Component Id="UninstallPs1" Guid="*" Win64="yes">
                <File Id="UninstallPs1File" Source="scripts/windows/uninstall.ps1" KeyPath="yes" />
            </Component>
            <Component Id="SetupDbPs1" Guid="*" Win64="yes">
                <File Id="SetupDbPs1File" Source="scripts/windows/setup_db.ps1" KeyPath="yes" />
            </Component>
            <Component Id="SetupCachePs1" Guid="*" Win64="yes">
                <File Id="SetupCachePs1File" Source="scripts/windows/setup_cache.ps1" KeyPath="yes" />
            </Component>
            <Component Id="BackupDataPs1" Guid="*" Win64="yes">
                <File Id="BackupDataPs1File" Source="scripts/windows/backup_data.ps1" KeyPath="yes" />
            </Component>
        </ComponentGroup>

        <ComponentGroup Id="ServiceComponents" Directory="INSTALLFOLDER">
            <Component Id="BackendWinSWExe" Guid="*" Win64="yes">
                <File Id="BackendWinSWExeFile" Source="deploy/windows/DataLogic_Backend.exe" KeyPath="yes" />
            </Component>
            <Component Id="FrontendWinSWExe" Guid="*" Win64="yes">
                <File Id="FrontendWinSWExeFile" Source="deploy/windows/DataLogic_Frontend.exe" KeyPath="yes" />
            </Component>
            <Component Id="BackendSvcXml" Guid="*" Win64="yes">
                <File Id="BackendSvcXmlFile" Source="deploy/windows/DataLogic_Backend.xml" KeyPath="yes" />
            </Component>
            <Component Id="FrontendSvcXml" Guid="*" Win64="yes">
                <File Id="FrontendSvcXmlFile" Source="deploy/windows/DataLogic_Frontend.xml" KeyPath="yes" />
            </Component>
        </ComponentGroup>
    </Fragment>
</Wix>
