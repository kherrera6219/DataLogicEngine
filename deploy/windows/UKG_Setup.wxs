<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
    <Product Id="*" Name="DataLogicEngine" Language="1033" Version="1.2.4.0" Manufacturer="DataLogic" UpgradeCode="a8342468-b391-4d1a-96e0-1c8632607831">
        <Package InstallerVersion="200" Compressed="yes" InstallScope="perMachine" />

        <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
        <MediaTemplate EmbedCab="yes" />

        <Feature Id="ProductFeature" Title="DataLogicEngine" Level="1">
            <ComponentGroupRef Id="ProductComponents" />
            <ComponentGroupRef Id="ServiceComponents" />
        </Feature>

        <UI>
            <UIRef Id="WixUI_InstallDir" />
            <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="2">1</Publish>
            <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2">1</Publish>
        </UI>
        <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    </Product>

    <Fragment>
        <Directory Id="TARGETDIR" Name="SourceDir">
            <Directory Id="ProgramFiles64Folder">
                <Directory Id="INSTALLFOLDER" Name="DataLogicEngine" />
            </Directory>
            <Directory Id="CommonAppDataFolder">
                <Directory Id="DATAFOLDER" Name="DataLogicEngine" />
            </Directory>
            <Directory Id="ProgramMenuFolder">
                <Directory Id="ApplicationProgramsFolder" Name="DataLogicEngine"/>
            </Directory>
        </Directory>
    </Fragment>

    <Fragment>
        <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
            <!-- Backend Binary -->
            <Component Id="BackendExe" Guid="*">
                <File Id="BackendExeFile" Source="dist\DataLogic_Backend\DataLogic_Backend.exe" KeyPath="yes" />
            </Component>
            
            <!-- Frontend Standalone -->
            <Component Id="FrontendServer" Guid="*">
                <File Id="FrontendServerFile" Source="frontend\.next\standalone\server.js" KeyPath="yes" />
            </Component>

            <!-- Shortcut -->
            <Component Id="ApplicationShortcut" Guid="*">
                <Shortcut Id="ApplicationStartMenuShortcut" 
                          Name="DataLogicEngine" 
                          Description="Launch DataLogicEngine Desktop" 
                          Target="[BROWSER_PATH]" 
                          Arguments="http://localhost:3000"
                          WorkingDirectory="INSTALLFOLDER"/>
                <RemoveFolder Id="CleanupShortcut" On="uninstall"/>
                <RegistryValue Root="HKCU" Key="Software\DataLogic\DataLogicEngine" Name="installed" Type="integer" Value="1" KeyPath="yes"/>
            </Component>
        </ComponentGroup>

        <ComponentGroup Id="ServiceComponents" Directory="INSTALLFOLDER">
            <!-- WinSW Binaries and Configs will be handled here -->
        </ComponentGroup>
    </Fragment>
</Wix>
