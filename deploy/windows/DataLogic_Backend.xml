<service>
  <id>DataLogic_Backend</id>
  <name>DataLogic_Backend</name>
  <description>DataLogicEngine Backend Service (Flask)</description>
  <workingdirectory>%BASE%</workingdirectory>
  <executable>%BASE%\DataLogic_Backend_App.exe</executable>
  <env name="PORT" value="5000"/>
  <env name="FLASK_ENV" value="production"/>
  <env name="USE_REDIS" value="false"/>
  <env name="SESSION_COOKIE_SECURE" value="true"/>
  <log mode="roll">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>5</keepFiles>
  </log>
  <onfailure action="restart" delay="10 sec"/>
</service>
