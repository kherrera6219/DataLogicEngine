{
  "name": "frontend",
  "version": "4.4.1",
  "description": "Local-first AI orchestration and knowledge-graph workspace for desktop and web",
  "author": "Kevin Herrera",
  "private": true,
  "main": "dist-electron/main.js",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "tokens:build": "node scripts/generate-design-tokens.mjs",
    "electron:build": "node scripts/clean-electron-build.mjs && tsc -p electron",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://127.0.0.1:3000 && npm run electron:build && electron .\"",
    "electron:dist": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-backend-for-installer.ps1 && cross-env BUILD_MODE=electron npm run build && npm run electron:build && npm run fix:eb && electron-builder && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/copy-installer-to-root.ps1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:a11y:ci": "cross-env NEXT_PUBLIC_APP_RUNTIME_MODE=local concurrently -k -s first -n WEB,A11Y \"npm run start -- -p 3200\" \"wait-on http://127.0.0.1:3200 && node scripts/run-a11y-ci.mjs\"",
    "test:app-readiness": "playwright test tests/e2e/app-readiness-evidence.spec.ts tests/e2e/keyboard-navigation-evidence.spec.ts -c playwright-visual.config.ts",
    "test:e2e": "playwright test -c playwright-electron.config.ts",
    "test:e2e:visual": "playwright test -c playwright-visual.config.ts",
    "test:e2e:visual:update": "playwright test -c playwright-visual.config.ts --update-snapshots",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "fix:eb": "node scripts/patch-electron-builder.mjs",
    "postinstall": "node scripts/patch-electron-builder.mjs"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.562.0",
    "next": "^16.2.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-force-graph-3d": "^1.29.0",
    "recharts": "^3.6.0",
    "socket.io-client": "^4.8.3",
    "swr": "^2.3.8",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@axe-core/cli": "^4.12.1",
    "@chromatic-com/storybook": "3.2.3",
    "@cyclonedx/cyclonedx-npm": "6.0.0",
    "@next/bundle-analyzer": "^16.2.12",
    "@playwright/test": "^1.58.1",
    "@storybook/addon-a11y": "^8.6.18",
    "@storybook/addon-backgrounds": "^8.6.18",
    "@storybook/addon-controls": "^8.6.18",
    "@storybook/addon-docs": "^8.6.18",
    "@storybook/addon-interactions": "^8.6.18",
    "@storybook/addon-links": "^8.6.18",
    "@storybook/addon-measure": "^8.6.18",
    "@storybook/addon-onboarding": "^8.6.18",
    "@storybook/addon-outline": "^8.6.18",
    "@storybook/addon-toolbars": "^8.6.18",
    "@storybook/addon-viewport": "^8.6.18",
    "@storybook/blocks": "^8.6.18",
    "@storybook/react": "^8.6.18",
    "@storybook/react-vite": "^8.6.18",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/recharts": "^1.8.29",
    "@vitejs/plugin-react": "^5.1.3",
    "@vitest/coverage-v8": "^4.1.8",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "43.1.1",
    "electron-builder": "^26.15.3",
    "electron-store": "^11.0.2",
    "eslint": "^9",
    "eslint-config-next": "^16.2.12",
    "jsdom": "^28.0.0",
    "playwright": "^1.58.0",
    "storybook": "^8.6.18",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.0.5",
    "vitest": "^4.1.8",
    "wait-on": "^9.1.0"
  },
  "eslintConfig": {
    "extends": [
      "plugin:storybook/recommended"
    ]
  },
  "overrides": {
    "adm-zip": "^0.6.0",
    "axios": "^1.18.0",
    "fast-uri": "^3.1.4",
    "ip-address": "^10.2.2",
    "undici": "^7.29.0",
    "js-yaml": "^4.3.0",
    "postcss": "^8.5.18",
    "sharp": "^0.35.0",
    "tar": "^7.5.18",
    "tmp": "^0.2.7",
    "shell-quote": "^1.9.0",
    "socket.io-parser": "^4.2.7"
  }
}
