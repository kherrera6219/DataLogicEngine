{
  "name": "frontend",
  "version": "0.1.1",
  "description": "DataLogicEngine Desktop Application",
  "author": "UKG",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "tokens:build": "node scripts/generate-design-tokens.mjs",
    "electron:build": "tsc -p electron",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://127.0.0.1:3000 && npm run electron:build && electron .\"",
    "electron:dist": "cross-env BUILD_MODE=electron npm run build && npm run electron:build && electron-builder && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/copy-installer-to-root.ps1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:a11y:ci": "concurrently -k -s first -n WEB,A11Y \"npm run start -- -p 3200\" \"wait-on http://127.0.0.1:3200 && node scripts/run-a11y-ci.mjs\"",
    "test:e2e": "playwright test -c playwright-electron.config.ts",
    "test:e2e:visual": "playwright test -c playwright-visual.config.ts",
    "test:e2e:visual:update": "playwright test -c playwright-visual.config.ts --update-snapshots",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.562.0",
    "next": "^16.1.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-force-graph-3d": "^1.29.0",
    "recharts": "^3.6.0",
    "socket.io-client": "^4.8.3",
    "swr": "^2.3.8",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@axe-core/cli": "^4.11.0",
    "@chromatic-com/storybook": "3.2.3",
    "@next/bundle-analyzer": "^16.1.6",
    "@playwright/test": "^1.58.1",
    "@storybook/addon-a11y": "^8.6.15",
    "@storybook/addon-essentials": "^8.6.15",
    "@storybook/addon-interactions": "^8.6.15",
    "@storybook/addon-links": "^8.6.15",
    "@storybook/addon-onboarding": "^8.6.15",
    "@storybook/blocks": "^8.6.15",
    "@storybook/react": "^8.6.15",
    "@storybook/react-vite": "^8.6.15",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.19.30",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/recharts": "^1.8.29",
    "@vitejs/plugin-react": "^5.1.3",
    "@vitest/coverage-v8": "^4.0.18",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^40.0.0",
    "electron-builder": "^26.7.0",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.7.3",
    "eslint": "^9",
    "eslint-config-next": "^16.1.6",
    "eslint-plugin-storybook": "^0.11.0",
    "jsdom": "^28.0.0",
    "playwright": "^1.58.0",
    "storybook": "^8.6.15",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.0.5",
    "vitest": "^4.0.18",
    "wait-on": "^9.0.3"
  },
  "eslintConfig": {
    "extends": [
      "plugin:storybook/recommended"
    ]
  }
}
