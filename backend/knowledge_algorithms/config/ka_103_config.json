{
    "mesh_provider": "istio_mock",
    "mTLS_enabled": true,
    "retry_policy": {
        "max_attempts": 3,
        "retry_on": ["5xx", "gateway-timeout"]
    },
    "circuit_breaker": {
        "error_threshold_percent": 25,
        "reset_timeout_seconds": 60
    },
    "tracing_header": "X-B3-TraceId"
}
