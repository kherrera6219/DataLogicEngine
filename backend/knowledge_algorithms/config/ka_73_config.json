{
    "target_schema": "dle.secure-ingestion-metadata.v1",
    "transformation_rules": [
        {"field": "record_id", "target_type": "trimmed_string"},
        {"field": "relative_path", "target_type": "trimmed_string"},
        {"field": "source_sha256", "target_type": "lowercase_sha256"},
        {"field": "size_bytes", "target_type": "integer"},
        {"field": "detected_type", "target_type": "lowercase_string"}
    ],
    "enable_projection": false,
    "drop_unmapped_fields": false
}
