# Universal Knowledge Graph (UKG) System Environment Variables
# Auto-generated configuration for development

# Application settings
FLASK_ENV=development
PORT=8080
SECRET_KEY=39a6ca10a4feb0aebe7935aa8572f67127931c8e924ce904754846bf5d4403de
JWT_SECRET_KEY=3bff2da48ee5f324658944e0768c03fbcd5f112c33aa1d882eaddf8ec211f8fe
SESSION_SECRET=39a6ca10a4feb0aebe7935aa8572f67127931c8e924ce904754846bf5d4403de

# Database settings (SQLite for development - change to PostgreSQL for production)
DATABASE_URL=sqlite:///ukg_database.db
PGUSER=
PGPASSWORD=
PGHOST=
PGPORT=
PGDATABASE=

# Logging settings
LOG_LEVEL=INFO
LOG_FILE=ukg_system.log

# UKG system settings
UKG_MAX_SIMULATION_LAYERS=7
UKG_DEFAULT_CONFIDENCE_THRESHOLD=0.85
UKG_DEFAULT_REFINEMENT_STEPS=12
UKG_MEMORY_CACHE_SIZE=4096
UKG_ENABLE_QUANTUM_SIMULATION=false
UKG_ENABLE_RECURSIVE_PROCESSING=true

# Microsoft Enterprise Integration (Azure AD) - Leave empty for development
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=

# Microsoft Azure OpenAI Integration - Leave empty for development
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2023-05-15

# Microsoft Azure Storage - Leave empty for development
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=ukg-media

# Microsoft Graph API - Leave empty for development
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_TENANT_ID=

# Cross-Origin Resource Sharing (CORS)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Frontend settings
REACT_APP_API_URL=http://localhost:8080/api
REACT_APP_AUTH_PROVIDER=local

# Security settings
# CRITICAL: Set to 'true' in production to enable HTTPS-only cookies
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
REMEMBER_COOKIE_SECURE=true
REMEMBER_COOKIE_DURATION=2592000

# Admin user (for initial setup)
# ⛔ CRITICAL SECURITY WARNING ⛔
# Default credentials have been disabled for security
# To create an admin user, run: python scripts/create_admin_user.py
# OR set your own secure credentials below (minimum 12 characters, complex password)
#
# SECURITY REQUIREMENTS:
# - Username: NOT 'admin', 'administrator', 'root', 'test', or 'user'
# - Password: Minimum 12 characters with uppercase, lowercase, digit, and symbol
#
# Example of generating secure credentials:
# python -c "import secrets; print('ADMIN_USERNAME=' + secrets.token_hex(8))"
# python -c "import secrets; print('ADMIN_PASSWORD=' + secrets.token_urlsafe(32))"
#
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_EMAIL=

# ============================================================================
# Rate Limiting & Caching (Redis)
# ============================================================================
# Redis URL for distributed rate limiting and caching
# Production: Use managed Redis instance (AWS ElastiCache, Azure Cache for Redis)
# Development: Use local Redis (docker run -d -p 6379:6379 redis:alpine)
#             OR use memory:// for testing without Redis
REDIS_URL=redis://localhost:6379/0
RATELIMIT_STORAGE_URI=redis://localhost:6379/1

# Rate Limiting Configuration
GLOBAL_RATE_LIMIT=200 per hour
API_RATE_LIMIT=1000 per hour
AUTH_RATE_LIMIT=10 per minute

# ============================================================================
# Background Task Queue (Celery)
# ============================================================================
# Celery Configuration for async task processing
CELERY_BROKER_URL=redis://localhost:6379/2
CELERY_RESULT_BACKEND=redis://localhost:6379/3

# ============================================================================
# Request & Connection Settings
# ============================================================================
# Request timeout (seconds) - prevents hanging requests
REQUEST_TIMEOUT=30
MAX_CONTENT_LENGTH=16777216

# Database connection pool settings (production)
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=300

ENCRYPTION_KEK_SECRET=dev_kek_secret_fixed_for_stability_1234567890
